//DAILYPOL JOB (ACCT),'DAILY POLICY LOAD',CLASS=A,MSGCLASS=X
//*
//* Demo batch job: nightly policy data-access step.
//* Runs a real GenApp DB2 access program (which COPYs LGPOLICY).
//*
//STEP01   EXEC PGM=LGACDB01
//POLFILE  DD DSN=INS.POLICY.MASTER,DISP=SHR
//CUSTFILE DD DSN=INS.CUSTOMER.MASTER,DISP=SHR
//OUTLOG   DD DSN=INS.POLICY.LOADLOG(+1),DISP=(NEW,CATLG,DELETE)
//*
//* Demo batch step with a real SELECT/ASSIGN -> DD -> DSN lineage
//STEP02   EXEC PGM=LGBATCH
//POLFILE  DD DSN=INS.POLICY.MASTER,DISP=SHR
